@using PractiseDN.Dto
@model UserDto

<div>@ViewBag.ErrorMessage</div>

<form class="w-50 mx-auto mt-5 p-4 border rounded shadow" asp-action="CreateUser"> 

    <h3 class="text-center mb-4">Registration</h3>

    <div class="mb-3">
        <label for="username" class="form-label">Username</label>
        <input type="text"
               class="form-control"
               id="username"
               name="username"
               asp-for="Username"
               placeholder="Enter username"
               required>
    </div>

    <div class="mb-3">
        <label for="email" class="form-label">Email</label>
        <input type="email"
               class="form-control"
               id="email"
               name="email"
               asp-for="Email"
               placeholder="Enter email"
               required>
    </div>

    <div class="mb-3">
        <label for="password" class="form-label">Password</label>
        <input type="password"
               class="form-control"
               id="password"
               name="password"
               asp-for="Password"
               placeholder="Enter password"
               required>
    </div>

    <div class="d-grid">
        <input type="submit" class="btn btn-primary" value="Submit">
    </div>

</form>

